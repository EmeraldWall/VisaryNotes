<!-- Adaptive icon foreground. Everything sits inside the 66dp safe circle centred at (54,54), so circle,
     squircle, rounded square and teardrop masks never cut the mark. A paper sheet with a folded corner
     (notes), an emerald V (Visary) and two lines of text (reading). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Flat lift under the sheet. -->
    <path android:fillColor="#33000000" android:pathData="M37,30.5H63L73,40.5V80.5H37Z" />
    <!-- Sheet with the top right corner folded at the 8dp chamfer of the design system, scaled. -->
    <path android:fillColor="#FFFBFAF7" android:pathData="M36,29H62L72,39V79H36Z" />
    <path android:fillColor="#FFD9D6CC" android:pathData="M62,29V39H72Z" />
    <!-- The V, a solid shape with a flat foot so it clears the text lines. -->
    <path android:fillColor="#FF0A6249" android:pathData="M40.4,43.5L45.6,40.5L54,55L62.4,40.5L67.6,43.5L56.6,62.5H51.4Z" />
    <!-- Two lines of text in ink. -->
    <path android:fillColor="#FF15181A" android:pathData="M42,66.5H66V69.5H42Z" />
    <path android:fillColor="#FF15181A" android:pathData="M42,72H58V75H42Z" />
</vector>
