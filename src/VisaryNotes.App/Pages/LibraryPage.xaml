<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:VisaryNotes.App.Pages"
             xmlns:controls="clr-namespace:VisaryNotes.App.Controls"
             x:Class="VisaryNotes.App.Pages.LibraryPage"
             x:DataType="pages:LibraryPage"
             Title="Library">

    <Grid>
        <!-- Read zone: content scrolls under the glass strip and the dock (docs/DESIGN.md 5.2). -->
        <CollectionView x:Name="List" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout>
                    <BoxView HeightRequest="{StaticResource HStrip}" Color="Transparent" />
                    <controls:Pressable x:Name="ContinueRow" IsVisible="False" Padding="{StaticResource InsetRow}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Sp3}">
                            <Border Style="{StaticResource Badge}" BackgroundColor="{DynamicResource Ink}">
                                <Label x:Name="ContinueBadge" Style="{StaticResource BadgeText}" TextColor="{DynamicResource Paper}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Sp1}" VerticalOptions="Center">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="ContinueTitle" Style="{StaticResource T1}" />
                                    <Label x:Name="ContinueProgress" Grid.Column="1" Style="{StaticResource T2}" FontFamily="FigtreeBold" TextColor="{DynamicResource Ink}" />
                                </Grid>
                                <Grid HeightRequest="4" BackgroundColor="{DynamicResource Line}" ColumnDefinitions="*">
                                    <BoxView x:Name="ContinueBar" Color="{DynamicResource Accent}" HorizontalOptions="Start" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </controls:Pressable>
                    <!-- First run: three clear ways in and the promises that lower the cost of trying (docs/UX-REVIEW.md, TPB and IDT). -->
                    <VerticalStackLayout x:Name="EmptyText" IsVisible="False" Padding="{StaticResource InsetSheet}" Spacing="{StaticResource Sp3}">
                        <Label Text="Your reading and your notes, in one place" Style="{StaticResource T1}" FontFamily="FigtreeBold" MaxLines="2" LineBreakMode="WordWrap" />
                        <Label Style="{StaticResource T2}" TextColor="{DynamicResource Ink}" MaxLines="4" LineBreakMode="WordWrap"
                               Text="Open a file someone sent you, select a passage, and quote it into a note. The quote keeps a link back to its page." />
                        <controls:Pressable x:Name="EmptyOpen" Style="{StaticResource WideButtonPrimary}" SemanticProperties.Description="Open a document">
                            <Label Text="Open a document" Style="{StaticResource WideButtonPrimaryText}" />
                        </controls:Pressable>
                        <controls:Pressable x:Name="EmptyNote" Style="{StaticResource WideButton}" SemanticProperties.Description="Write a note">
                            <Label Text="Write a note" Style="{StaticResource WideButtonText}" />
                        </controls:Pressable>
                        <controls:Pressable x:Name="EmptyImport" Style="{StaticResource WideButton}" SemanticProperties.Description="Bring Markdown notes from another app">
                            <Label Text="Bring Markdown notes" Style="{StaticResource WideButtonText}" />
                        </controls:Pressable>
                        <Label Style="{StaticResource T2}" MaxLines="3" LineBreakMode="WordWrap"
                               Text="Works offline. No account. Notes stay plain Markdown that you can take anywhere." />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pages:LibraryRow">
                    <!-- Row actions sit behind a visible more button instead of a hidden swipe, so they can be
                         found, reached by TalkBack, and the list stays light to scroll (docs/UX-REVIEW.md). -->
                    <Grid BackgroundColor="{DynamicResource Paper}" ColumnDefinitions="*,Auto">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Sp3}"
                              Padding="{StaticResource InsetRowLead}" MinimumHeightRequest="{Binding RowHeight}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}" BackgroundColor="{Binding BadgeFill}">
                                <Label Text="{Binding Badge}" Style="{StaticResource BadgeText}" TextColor="{Binding BadgeInk}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Sp3}">
                                    <Label Text="{Binding Title}" Style="{StaticResource T1}" />
                                    <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource T2}" />
                                </Grid>
                                <Label Text="{Binding Snippet}" Style="{StaticResource T2}" IsVisible="{Binding ShowSnippet}" />
                            </VerticalStackLayout>
                        </Grid>
                        <controls:Pressable Grid.Column="1" WidthRequest="{StaticResource HControl}" HeightRequest="{StaticResource HControl}"
                                            VerticalOptions="Center" Margin="{StaticResource InsetRowTrail}"
                                            SemanticProperties.Description="{Binding MoreLabel}">
                            <controls:Pressable.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMoreTapped" />
                            </controls:Pressable.GestureRecognizers>
                            <Path Data="M5 12H6M11.5 12H12.5M18 12H19" Stroke="{DynamicResource InkBrush}" StrokeThickness="2.5"
                                  StrokeLineCap="Square" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                        </controls:Pressable>
                        <BoxView Grid.ColumnSpan="2" HeightRequest="1" Color="{DynamicResource Line}" VerticalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="220" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Glance zone: passive information only. Settings is rarely used, so it may live here. -->
        <controls:GlassView VerticalOptions="Start" HeightRequest="{StaticResource HStrip}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Sp3}" Padding="{StaticResource InsetStrip}">
                <Label Text="Library" Style="{StaticResource StripTitle}" />
                <Label x:Name="Counts" Grid.Column="1" Style="{StaticResource T2}" VerticalTextAlignment="Center" />
                <controls:Pressable x:Name="SettingsButton" Grid.Column="2" WidthRequest="{StaticResource HControl}" HeightRequest="{StaticResource HControl}"
                                    SemanticProperties.Description="Settings" />
            </Grid>
        </controls:GlassView>

        <!-- Act zone: floating action pill above the filter tabs (docs/DESIGN.md 4.4, E1 to E3). -->
        <VerticalStackLayout x:Name="Dock" VerticalOptions="End">
            <Grid Padding="{StaticResource InsetPillRow}">
                <controls:ActionPill x:Name="Pill" />
                <Grid x:Name="SearchRow" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Sp2}">
                    <Border Style="{StaticResource Field}">
                        <Entry x:Name="SearchEntry" Placeholder="Search notes and documents" ReturnType="Search"
                               SemanticProperties.Description="Search notes and documents" />
                    </Border>
                    <controls:GlassView Grid.Column="1" IsPill="True" WidthRequest="{StaticResource HPrimary}" HeightRequest="{StaticResource HPrimary}">
                        <controls:Pressable x:Name="CancelSearch" SemanticProperties.Description="Cancel search" />
                    </controls:GlassView>
                </Grid>
            </Grid>
            <controls:GlassView>
                <controls:Segments x:Name="Filters" Margin="{StaticResource InsetBar}" />
            </controls:GlassView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
