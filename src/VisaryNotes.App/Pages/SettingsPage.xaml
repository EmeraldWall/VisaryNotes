<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VisaryNotes.App.Controls"
             x:Class="VisaryNotes.App.Pages.SettingsPage"
             Title="Settings">

    <Grid>
        <ScrollView>
            <VerticalStackLayout>
                <BoxView HeightRequest="{StaticResource HStrip}" Color="Transparent" />

                <Label Text="Hand" Style="{StaticResource Cap}" />
                <controls:Segments x:Name="Hands" Margin="{StaticResource InsetScreen}" />
                <Label Style="{StaticResource T2}" MaxLines="3" LineBreakMode="WordWrap" Margin="{StaticResource InsetScreen}"
                       Text="Moves the action pill to that thumb. You can also swipe the pill sideways. Centre suits both hands." />

                <Label Text="Density" Style="{StaticResource Cap}" />
                <controls:Segments x:Name="Densities" Margin="{StaticResource InsetScreen}" />

                <Label Text="Theme" Style="{StaticResource Cap}" />
                <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                <VerticalStackLayout x:Name="ThemeList" />

                <Label Text="Reading" Style="{StaticResource Cap}" />
                <Grid ColumnDefinitions="*,Auto" Padding="{StaticResource InsetRow}" MinimumHeightRequest="{StaticResource HRow}">
                    <Label x:Name="FontSizeLabel" Style="{StaticResource T1}" VerticalTextAlignment="Center" />
                    <Stepper x:Name="FontSize" Grid.Column="1" Minimum="14" Maximum="28" Increment="1" />
                </Grid>

                <Label Text="Glass and privacy" Style="{StaticResource Cap}" />
                <Grid ColumnDefinitions="*,Auto" Padding="{StaticResource InsetRow}" MinimumHeightRequest="{StaticResource HRow}">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Reduce transparency" Style="{StaticResource T1}" />
                        <Label Text="Bars become solid paper" Style="{StaticResource T2}" />
                    </VerticalStackLayout>
                    <Switch x:Name="Solid" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="{StaticResource InsetRow}" MinimumHeightRequest="{StaticResource HRow}">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Load images from the web" Style="{StaticResource T1}" />
                        <Label Text="Off keeps every file fully offline" Style="{StaticResource T2}" />
                    </VerticalStackLayout>
                    <Switch x:Name="Remote" Grid.Column="1" />
                </Grid>

                <Label Text="Bring your notes" Style="{StaticResource Cap}" />
                <controls:Pressable x:Name="ImportRow" Padding="{StaticResource InsetRow}" MinimumHeightRequest="{StaticResource HRow}">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Import Markdown files" Style="{StaticResource T1}" />
                        <Label x:Name="ImportStatus" Text="From Markor, Obsidian or any .md files" Style="{StaticResource T2}" />
                    </VerticalStackLayout>
                </controls:Pressable>

                <BoxView HeightRequest="160" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:GlassView VerticalOptions="Start" HeightRequest="{StaticResource HStrip}">
            <Label Text="Settings" Style="{StaticResource StripTitle}" Margin="{StaticResource InsetStrip}" />
        </controls:GlassView>

        <Grid VerticalOptions="End" Padding="{StaticResource InsetPillRow}">
            <controls:ActionPill x:Name="Pill" />
        </Grid>
    </Grid>
</ContentPage>
